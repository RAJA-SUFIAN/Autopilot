# Copy to .env and fill in what you need. Everything is optional - with no .env the tool
# runs in DEMO MODE using the rule-based parser.

PROJECT_NAME=Riyadh Smart Parking App

# --- AI meeting-notes parsing (free key: https://aistudio.google.com/apikey) ---
# Leave empty to use the rule-based parser (ACTION: Owner - task - YYYY-MM-DD - Priority).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email delivery ---
# false = DEMO MODE: every email is saved as an .html file in outbox/
# true  = send for real through Gmail SMTP (needs a Google App Password, not your normal password:
#         https://myaccount.google.com/apppasswords - requires 2-Step Verification)
SEND_EMAILS=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=PM Autopilot

# Weekly report recipients (comma-separated). Empty = every task owner in data/tasks.csv.
REPORT_RECIPIENTS=

# Time zone offset used for calendar invites (Riyadh = +03:00, no daylight saving).
MEETING_UTC_OFFSET=+03:00

# Optional path overrides (relative to the project root)
TASKS_CSV=data/tasks.csv
OUTBOX_DIR=outbox
